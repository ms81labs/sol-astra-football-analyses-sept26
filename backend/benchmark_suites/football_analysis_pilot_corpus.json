        ],
        "predictionSet": "all accepted pipeline ball boxes, with observed and inferred strata also reported separately",
        "association": "per evaluation frame, maximum-IoU one-to-one matching with deterministic input-order tie break",
        "iouThreshold": 0.5,
        "truePositive": "matched prediction and visible truth at IoU >= threshold",
        "falsePositive": "unmatched prediction on a visible or not_visible truth frame",
        "falseNegative": "unmatched visible truth",
        "localization": "report IoU and source-pixel center error over true positives",
        "falsePositivesPerMinuteDenominator": "non-ignored evaluation-frame duration"
      },
      "players": {
        "detectionAssociation": "per evaluation frame and entity kind, maximum-total-IoU one-to-one assignment at IoU >= 0.50 with truth trackId then predicted trackId as tie break",
