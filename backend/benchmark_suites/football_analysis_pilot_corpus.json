        "inclusionRule": "sourceStartFrame <= frameId < sourceEndFrameExclusive and frameId modulo frameStep equals 0",
        "predictionFrameIdentity": "pipeline Frame_ID is the original zero-based source-video frame index, not a compact sampled-frame ordinal; interval-only runs must add sourceStartFrame before scoring",
