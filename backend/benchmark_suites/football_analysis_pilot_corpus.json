      },
      "pitch": {
        "truthInput": "football_analysis_pilot_labels_v3 pitchPositionMeters values backed by the payload pitchReference source ID, SHA-256 and approved association method",
        "association": "predeclared source identity mapping or withheld control keypoints fixed without predictions; nearest-neighbor matching and fit-and-score-on-same-points are diagnostic only",
        "error": "Euclidean distance in metres; report matched count, reference coverage, median, p95 and maximum per source",
        "acceptance": "pitch bars cannot pass when independent association is unavailable or calibration is rejected"
      },
      "possession": {
        "teamMapping": "declare the match-specific my_team/enemy to home/away mapping before predictions are opened; unresolved predictions score as unknown",
        "frameScoring": "exact home or away agreement on evaluation frames; unknown truth is excluded from agreement and reported separately",
        "entityScoring": "possession track identity is compared only through that frame's accepted player association",
        "transitionDefinition": "on evaluation frames and available prediction frames, bridge unknown states and timestamp a home-away change at the first controlled frame for the new team; truth timing resolution is the evaluation cadence",
        "transitionError": "within each direction, minimum-total-absolute-distance one-to-one matching; report signed seconds and absolute seconds"
      },
      "events": {
        "classes": [
          "pass",
          "shot"
        ],
        "predictionTime": "pipeline event timestamp",
        "truthWindow": "labeled startFrame inclusive through endFrameExclusive, converted with sourceFps",
        "association": "within each class, maximize one-to-one matches then minimize distance from prediction time to the truth window; known truth team must agree; break ties by truth start, prediction time, eventId",
        "toleranceSeconds": 2.0,
        "truePositive": "matched prediction inside the truth window expanded by tolerance",
        "falsePositive": "unmatched prediction",
        "falseNegative": "unmatched truth event"
      },
      "confidenceIntervals": {
        "level": 0.95,
        "proportions": "Wilson score interval without continuity correction",
        "continuousMetrics": "10,000-sample nonparametric percentile bootstrap",
        "bootstrapSamples": 10000,
        "percentileMethod": "linear",
        "bootstrapSeed": "unsigned base-16 value of the first 16 lower-case hex digits of SHA-256 over scoringProtocolVersion + newline + sourceId + newline + metricName"
      },
      "acceptance": {
        "unit": "sourceId",
        "decisionStatistic": "point estimate; confidence interval is mandatory context",
        "requiredResult": "every applicable frozen bar passes for every source; aggregate results are informational only",
        "zeroDenominator": "a class is not_applicable only when truth and prediction counts are both zero; precision is null when prediction count is zero and recall is null when truth count is zero; every non-null component is gated, so a one-sided nonzero class fails its defined counterpart at 0.0",
        "missingRequiredMetric": "not_passed"
      }
    },
